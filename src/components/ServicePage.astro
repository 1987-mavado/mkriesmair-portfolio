---
// One of the three service pages (Art Director / Creative Director / Creative Strategist).
// Static markup in the site's own visual language; no client-side JavaScript.
import Base from '../layouts/Base.astro';
import { SITE, routes, contact, personLd, type Lang } from '../data/seo';
import { services, ui } from '../data/services';

interface Props { lang: Lang; service: 'art' | 'cd' | 'strategy'; }
const { lang, service } = Astro.props;
const s = services[lang][service];
const t = ui[lang];
const other = lang === 'de' ? 'en' : 'de';
const home = routes.home[lang];
const others = (['art', 'cd', 'strategy'] as const).filter((k) => k !== service);
const url = SITE + routes[service][lang];
const jsonLd = [
  personLd(lang),
  {
    '@type': 'ProfilePage',
    '@id': `${url}#webpage`,
    url,
    name: s.metaTitle,
    description: s.metaDescription,
    inLanguage: lang,
    isPartOf: { '@id': `${SITE}/#website` },
    about: { '@id': `${SITE}/#person` },
    mainEntity: { '@id': `${SITE}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Markus Kriesmair', item: SITE + home },
      { '@type': 'ListItem', position: 2, name: t.names[service], item: url },
    ],
  },
];
const arrow = 'M2.5 8h11M8.5 3l5 5-5 5';
---
<Base lang={lang} title={s.metaTitle} description={s.metaDescription} alternates={routes[service]} jsonLd={jsonLd}>
  <header class="sv-head wrap">
    <a href={home} class="sv-logo" aria-label="Markus Kriesmair"><img src="/uploads/240316-logo-markus-kriesmair-abbinder.png" alt="markus kriesmair" width="226" height="44" /></a>
    <nav class="sv-nav" aria-label="Main">
      <a href={home} class="sv-nav-home">{t.navHome}</a>
      <a href={routes.art[lang]} aria-current={service === 'art' ? 'page' : undefined}>{t.navArt}</a>
      <a href={routes.cd[lang]} aria-current={service === 'cd' ? 'page' : undefined}>{t.navCd}</a>
      <a href={routes.strategy[lang]} aria-current={service === 'strategy' ? 'page' : undefined}>{t.navStrategy}</a>
      <a href="#contact" class="sv-nav-contact">{t.navContact} <svg aria-hidden="true" viewBox="0 0 16 16"><path d={arrow} /></svg></a>
    </nav>
    <div class="sv-lang" role="group" aria-label={t.langLabel}>
      <a href={routes[service].de} hreflang="de" lang="de" aria-label="Deutsch" aria-current={lang === 'de' ? 'true' : undefined}>DE</a><span aria-hidden="true">|</span><a href={routes[service].en} hreflang="en" lang="en" aria-label="English" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </div>
  </header>

  <main class="wrap">
    <section class="grid sv-hero">
      <div class="c-label label sv-pt">{s.label}</div>
      <div class="c-main">
        <h1 class="tanker">{s.h1}</h1>
        <p class="lead sv-lead">{s.lead}</p>
      </div>
    </section>

    <section class="grid sv-sec" aria-labelledby="focus">
      <h2 id="focus" class="c-label label sv-h2">{s.focusLabel}</h2>
      <ul class="c-main sv-focus">
        {s.focus.map((f, i) => (
          <li>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="tanker">{f.title}</h3>
            <p class="body-m">{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="sv-sec" aria-labelledby="work">
      <div class="grid sv-work-head">
        <h2 id="work" class="c-label label sv-h2">{s.workLabel}</h2>
        <p class="c-main lead">{s.workIntro}</p>
      </div>
      {s.cases.map((c, i) => (
        <article class:list={['grid', 'sv-case', { flip: i % 2 === 1 }]}>
          <a href={`${home}#${c.anchor}`} class="sv-case-img" tabindex="-1" aria-hidden="true"><img src={c.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
          <div class="sv-case-txt">
            <div class="label-500"><span>{String(i + 1).padStart(2, '0')} — {c.brand}</span></div>
            <h3 class="tanker">{c.title}</h3>
            <p class="body-m">{c.body}</p>
            <dl><dt class="label-500">{t.role}</dt><dd>{c.role}</dd></dl>
            <a href={`${home}#${c.anchor}`} class="sv-link">{t.seeCase}<span class="vh">: {c.brand}</span> <svg aria-hidden="true" viewBox="0 0 16 16"><path d={arrow} /></svg></a>
          </div>
        </article>
      ))}
      <div class="grid"><a href={`${home}#work`} class="c-main sv-link">{t.allWork} <svg aria-hidden="true" viewBox="0 0 16 16"><path d={arrow} /></svg></a></div>
    </section>

    <section class="grid sv-sec" aria-labelledby="exp">
      <h2 id="exp" class="c-label label sv-h2">{s.expLabel}</h2>
      <div class="c-m6 sv-exp">{s.exp.map((p) => <p>{p}</p>)}</div>
    </section>

    <section class="grid sv-sec" aria-labelledby="also">
      <h2 id="also" class="c-label label sv-h2">{t.also}</h2>
      <div class="c-main sv-also">
        <p class="lead">{t.alsoIntro}</p>
        <div class="sv-also-links">
          {others.map((k) => <a href={routes[k][lang]} class="sv-link">{t.names[k]} <svg aria-hidden="true" viewBox="0 0 16 16"><path d={arrow} /></svg></a>)}
        </div>
      </div>
    </section>

    <section id="contact" class="grid sv-sec sv-contact" aria-labelledby="contact-h">
      <div class="c-label label sv-pt">{t.contactLabel}</div>
      <div class="c-main">
        <h2 id="contact-h" class="tanker">{t.contactH}</h2>
        <p class="lead sv-lead">{t.contactLead}</p>
      </div>
      <div class="c-full sv-cards">
        <a href={`mailto:${contact.email}`}><span class="label">{t.email}</span><span>{contact.email}</span></a>
        <a href={contact.phoneHref}><span class="label">{t.phone}</span><span>{contact.phone}</span></a>
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer"><span class="label">{t.profile}</span><span>LinkedIn</span></a>
      </div>
    </section>

    <footer class="sv-foot label">
      <span>{t.footer}</span>
      <span><a href="/imprint/">{t.imprint}</a></span>
    </footer>
  </main>
</Base>

<style>
  .sv-head { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 20px; }
  .sv-logo img { display: block; height: 44px; width: auto; max-width: 56vw; filter: invert(1); }
  .sv-nav { display: flex; gap: 28px; align-items: center; margin-left: auto; font-size: 16px; font-weight: 300; white-space: nowrap; }
  .sv-nav a:hover, .sv-lang a:hover, .sv-foot a:hover { color: var(--label); text-decoration: none; }
  .sv-nav a[aria-current] { font-weight: 500; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .sv-nav-contact { font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
  svg { width: .8em; height: .8em; flex: none; overflow: visible; }
  svg path { fill: none; stroke: currentColor; stroke-width: 2.8; stroke-linecap: square; stroke-linejoin: round; }
  .sv-lang { display: flex; gap: 8px; align-items: center; font-size: 13px; letter-spacing: .06em; color: var(--dim); }
  .sv-lang a { color: var(--label); font-weight: 300; }
  .sv-lang a[aria-current] { color: var(--text); font-weight: 700; }
  @media (max-width: 980px) {
    .sv-lang { order: 2; margin-left: auto; }
    .sv-nav { order: 3; margin-left: 0; flex: 1 0 100%; justify-content: space-between; gap: 6px; font-size: clamp(10px, 2.95vw, 16px); min-width: 0; }
  }
  /* On phones the logo already links home, so the nav drops that item to stay on one row. */
  @media (max-width: 560px) { .sv-nav-home { display: none; } }

  .sv-pt { padding-top: .6em; }
  .sv-hero { padding: clamp(72px, 11vw, 160px) 0 96px; row-gap: 16px; }
  h1 { margin: 0; font-size: clamp(44px, 7.4vw, 112px); line-height: .92; text-transform: uppercase; text-wrap: balance; }
  .sv-lead { margin-top: 32px; max-width: 34ch; }
  .sv-sec { padding: 0 0 96px; row-gap: 24px; }
  .sv-h2 { margin: 0; font-weight: 400; padding-top: .3em; }

  .sv-focus { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px 24px; }
  .sv-focus li { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--line-2); }
  .sv-focus h3 { margin: 0; font-size: 22px; line-height: 1.15; text-transform: uppercase; }
  .sv-focus p { font-size: 15px; }

  .sv-work-head { row-gap: 16px; padding-bottom: 56px; }
  .sv-case { align-items: center; row-gap: 24px; padding-bottom: 72px; }
  .sv-case-img { grid-column: var(--g-a7); display: block; position: relative; aspect-ratio: 16 / 10; border-radius: 6px; overflow: hidden; background: var(--surface); }
  .sv-case-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .sv-case-img:hover img { transform: scale(1.03); }
  .sv-case-txt { grid-column: var(--g-b4); display: flex; flex-direction: column; gap: 16px; }
  .sv-case.flip .sv-case-img { grid-column: var(--g-b7); order: 2; }
  .sv-case.flip .sv-case-txt { grid-column: var(--g-a4); order: 1; }
  .sv-case-txt .label-500 span { color: var(--text); }
  .sv-case h3 { margin: 0; font-size: clamp(28px, 2.8vw, 40px); line-height: 1.05; text-wrap: balance; }
  dl { margin: 8px 0 0; display: flex; gap: 12px; align-items: baseline; font-size: 15px; color: var(--text-2); }
  dd { margin: 0; }
  .sv-link { display: inline-flex; align-items: center; gap: 8px; font-family: 'Tanker', 'Satoshi', sans-serif; font-size: 20px; line-height: 1; letter-spacing: .01em; text-transform: uppercase; color: var(--text); margin-top: 8px; }
  .sv-link:hover { color: var(--label); text-decoration: none; }
  @media (max-width: 900px) { .sv-case.flip .sv-case-img { order: 0; } }

  .sv-exp { display: flex; flex-direction: column; gap: 20px; }
  .sv-exp p { margin: 0; font-size: 18px; font-weight: 300; line-height: 1.55; color: var(--text-2); text-wrap: pretty; }
  .sv-also { display: flex; flex-direction: column; gap: 32px; }
  .sv-also-links { display: flex; gap: 16px 40px; flex-wrap: wrap; }
  .sv-also-links .sv-link { font-size: clamp(28px, 3.4vw, 48px); margin: 0; }

  .sv-contact { padding-top: 40px; padding-bottom: 32px; row-gap: 40px; }
  .sv-contact h2 { margin: 0; font-size: clamp(40px, 5.6vw, 80px); line-height: .95; text-transform: uppercase; text-wrap: balance; }
  .sv-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--g-gap); }
  .sv-cards a { background: var(--surface); border-radius: 6px; padding: 20px; display: flex; flex-direction: column; gap: 24px; font-size: 18px; }
  .sv-cards a:hover { background: var(--surface-2); text-decoration: none; }
  .sv-foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 48px 0 40px; }
  .sv-foot a { color: var(--label); }
  @media (prefers-reduced-motion: reduce) { .sv-case-img img { transition: none; } }
</style>
